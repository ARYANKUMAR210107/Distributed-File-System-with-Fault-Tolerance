# Master Node Configuration
MASTER_HOST=127.0.0.1
MASTER_PORT=8000
DATABASE_PATH=data/dfs_metadata.db
DEFAULT_CHUNK_SIZE=1048576
DEFAULT_REPLICATION_FACTOR=2
MAX_UPLOAD_SIZE_MB=200
HEALTH_CHECK_INTERVAL_SECONDS=10
NODE_TIMEOUT_SECONDS=5.0
NODE_FAILURE_THRESHOLD=2
AUTO_REPLICATE_ON_FAILURE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage Node Configuration (used when launching individual nodes)
NODE_ID=node-1
NODE_NAME=Storage Node 1
NODE_HOST=127.0.0.1
NODE_PORT=8001
STORAGE_DIR=storage/node1
MASTER_URL=http://127.0.0.1:8000
AUTO_REGISTER=true
