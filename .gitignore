logs/
tmp/
temp/

# Storage Node runtime chunk directories (preserve empty node folders via .gitkeep)
storage/*
!storage/node1/
storage/node1/*
!storage/node1/.gitkeep
!storage/node2/
storage/node2/*
!storage/node2/.gitkeep
!storage/node3/
storage/node3/*
!storage/node3/.gitkeep

# Frontend
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
