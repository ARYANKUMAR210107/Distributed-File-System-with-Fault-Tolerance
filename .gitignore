*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.coverage
htmlcov/

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key

# Runtime data, databases, PIDs, and logs
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite*
data/cluster_pids.json
